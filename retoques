async function eliminarEntry(id,src){
  if(!confirm('¿Eliminás este relevamiento?')) return;
  // Borrar local
  let local=JSON.parse(localStorage.getItem('historial')||'[]');
  local=local.filter(e=>String(e.id)!==String(id));
  localStorage.setItem('historial',JSON.stringify(local));
  // Borrar nube
  if(src==='cloud'&&sbReady){
    await sbFetch('DELETE',`/rest/v1/presupuestos?id=eq.${id}`);
  }
  renderHistorial();
  toast('Eliminado');
}

