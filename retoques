function renderResultados(){
  const totBocas  =rooms.reduce((s,r)=>s+r.items.bocas,0);
  const totToma   =rooms.reduce((s,r)=>s+r.items.tomacorrientes,0);
  const totLlaves =rooms.reduce((s,r)=>s+r.items.llaves,0);
  const totFocos  =rooms.reduce((s,r)=>s+r.items.focos,0);
  const totTV     =rooms.reduce((s,r)=>s+r.items.tv,0);
  const totDatos  =rooms.reduce((s,r)=>s+r.items.datos,0);
  const metrosBase=rooms.reduce((s,r)=>s+Number(r.metros),0);
  const distAcom  =parseInt(document.getElementById('tab-dist').value)||5;
  const esTri     =document.getElementById('tab-tension').value==='tri';
  const medNuevo  =document.getElementById('tab-medidor').value==='no';
  const termo     =parseInt(document.getElementById('tab-termo').value)||4;
  const dif       =parseInt(document.getElementById('tab-dif').value)||1;
  const disyT     =document.getElementById('tab-disyuntor').value;
  const disyN     =parseInt(disyT);
  const extras    =[...document.querySelectorAll('#tog-extra .tog.sel')].map(b=>b.textContent.trim());
  const conPAT    =extras.includes('Puesta a tierra');

  const mar=1.15;
  const c15=Math.round((metrosBase+distAcom)*2*mar);
  const c25=Math.round((totToma*4+distAcom)*mar);
  const c4 =esTri?Math.round((distAcom+4)*mar):0;
  const cT =Math.round((distAcom+metrosBase*0.3)*mar);
  const cC =Math.round(metrosBase*1.1);

  const matItems=[
    ['Cable unipolar 1.5mm² (rollo 100m)', Math.ceil(c15/100), 'cable15_r100', ML_Q.cable15_r100],
    ['Cable unipolar 2.5mm² (rollo 100m)', Math.ceil(c25/100), 'cable25_r100', ML_Q.cable25_r100],
  ];
  if(c4) matItems.push(['Cable unipolar 4mm² (rollo 100m)',Math.ceil(c4/100),'cable4_r100',ML_Q.cable4_r100]);
  matItems.push(['Cable tierra verde/amarillo (rollo 100m)',Math.ceil(cT/100),'tierra_r100',ML_Q.tierra_r100]);
  matItems.push(['Cañería corrugada 3/4" (rollo 100m)',Math.ceil(cC/100),'caneria_r100',ML_Q.caneria_r100]);
  matItems.push([`Tablero/gabinete ${esTri?'trifásico':'monofásico'}`,1,esTri?'tablero_tri':'tablero_mono',ML_Q[esTri?'tablero_tri':'tablero_mono']]);
  matItems.push([`Disyuntor principal ${disyT}`,1,`disy_${disyN}a`,ML_Q.disy_40a]);
