}
function removeRoom(id){rooms=rooms.filter(r=>r.id!==id);renderRooms();}
function updateRoomName(id,v){rooms.find(r=>r.id===id).name=v;}
function updateMetros(id,v){rooms.find(r=>r.id===id).metros=Math.max(1,parseInt(v)||1);}
function changeCounter(rid,key,delta){
  const r=rooms.find(r=>r.id===rid);
  r.items[key]=Math.max(0,(r.items[key]||0)+delta);
  const el=document.getElementById('cv-'+rid+'-'+key);
  if(el)el.textContent=r.items[key];
}
