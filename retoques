  const update = (now) => {
    const elapsed = now - startTime;
    const progress = Math.min(elapsed/duration, 1);
    const ease = 1 - Math.pow(1-progress, 3);
    const val = Math.round(start + (target-start)*ease);
    el.textContent = '$ ' + val.toLocaleString('es-AR');
    if(progress < 1) requestAnimationFrame(update);
  };
  requestAnimationFrame(update);
}

// Override renderResultados para animar totales
const _origRender = renderResultados;
renderResultados = function() {
  _origRender();
  // Animar el valor total
  setTimeout(() => {
    const pbox = document.getElementById('pbox');
    if(pbox) pbox.classList.add('show');
    const valEl = pbox?.querySelector('.val');
    if(valEl) {
      const raw = valEl.textContent.replace(/[^0-9]/g,'');
      const num = parseInt(raw)||0;
      animateCount(valEl, num, 900);
    }
  }, 50);
};

</script>
