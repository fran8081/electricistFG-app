.splash-bar-fill{height:100%;background:var(--purple);border-radius:2px;animation:barFill 1.2s ease 1.1s forwards;width:0}
@keyframes barFill{to{width:100%}}
@keyframes fadeUp{
  from{opacity:0;transform:translateY(10px)}
  to{opacity:1;transform:translateY(0)}
}

/* Rayo animado en header */
.hicon{position:relative;overflow:visible!important}
.hicon::after{content:'';position:absolute;inset:-4px;border-radius:12px;background:transparent;border:2px solid transparent;animation:iconPulse 3s ease-in-out infinite}
@keyframes iconPulse{
  0%,100%{box-shadow:0 0 8px rgba(124,58,237,.3)}
  50%{box-shadow:0 0 20px rgba(124,58,237,.7),0 0 40px rgba(124,58,237,.3)}
