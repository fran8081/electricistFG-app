  // Activar transición
  bt.classList.add('active');
  
  setTimeout(() => {
    landing.classList.add('exit');
  }, 150);

  setTimeout(() => {
    landing.style.display = 'none';
    app.style.opacity = '1';
    bt.classList.remove('active');
    shatter.innerHTML = '';
  }, 800);
}

