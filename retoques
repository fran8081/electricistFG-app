const RT=['Living / comedor','Dormitorio principal','Dormitorio','Cocina','Baño','Baño completo','Estudio','Garage','Lavadero','Pasillo','Patio / exterior'];
let rooms=[],roomId=0;

function addRoom(){
  const id=++roomId;
  rooms.push({id,name:RT[Math.min(roomId-1,RT.length-1)],metros:4,items:{bocas:0,tomacorrientes:0,llaves:0,focos:0,tv:0,datos:0}});
