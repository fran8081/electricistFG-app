  // Crear shards (fragmentos de pantalla que se van)
  for (let i = 0; i < 8; i++) {
    const s = document.createElement('div');
    s.className = 'bt-shard';
    const h = 12.5;
    s.style.cssText = `top:${i*h}%;left:0;width:100%;height:${h+.5}%;--dy:${(i%2===0?-1:1)*(20+i*15)}px;animation-delay:${i*.03}s;animation-duration:.5s`;
