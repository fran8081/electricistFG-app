let mlPrices={}, mlTs=null, mlSrc='fallback';

async function fetchML(q) {
  try {
    const r = await fetch('https://api.mercadolibre.com/sites/MLA/search?q='+encodeURIComponent(q)+'&limit=5', {signal:AbortSignal.timeout(5000)});
    if(!r.ok) return null;
    const d = await r.json();
    const ps = (d.results||[]).map(x=>x.price).filter(p=>p>500).sort((a,b)=>a-b);
    return ps[0]||null;
  } catch { return null; }
}

async function fetchAllML() {
  setStatus('loading');
  document.getElementById('mat-ts').textContent='Actualizando…';
  const keys=Object.keys(ML_Q), res={};
  let ok=0;
  for(let i=0;i<keys.length;i+=3) {
    const batch=keys.slice(i,i+3);
    const vals=await Promise.all(batch.map(k=>fetchML(ML_Q[k])));
    batch.forEach((k,j)=>{ if(vals[j]){res[k]=vals[j];ok++;} });
  }
  if(ok>=3){
    mlPrices=res; mlTs=new Date(); mlSrc='live';
    localStorage.setItem('mlP',JSON.stringify(res));
    localStorage.setItem('mlT',mlTs.toISOString());
    setStatus('online');
    document.getElementById('mat-ts').textContent='✓ ML '+fmtT(mlTs);
    return true;
  }
  setStatus('offline');
  document.getElementById('mat-ts').textContent='Sin internet — precios de referencia';
  return false;
}

function loadCached(){
  const s=localStorage.getItem('mlP'),t=localStorage.getItem('mlT');
  if(s&&t){mlPrices=JSON.parse(s);mlTs=new Date(t);mlSrc='cached';return true;}
  return false;
}
function gp(k){ return mlPrices[k]||FALLBACK[k]||0; }
function gpi(k){
  if(mlPrices[k]){
    if(mlSrc==='live')   return {p:mlPrices[k],s:'live'};
    if(mlSrc==='cached') return {p:mlPrices[k],s:'cache'};
  }
  return {p:FALLBACK[k]||0,s:'ref'};
}
function fmtT(d){ return d?d.toLocaleTimeString('es-AR',{hour:'2-digit',minute:'2-digit'})+' '+d.toLocaleDateString('es-AR',{day:'2-digit',month:'2-digit'}):''; }
function setStatus(s){
  const d=document.getElementById('sdot');
