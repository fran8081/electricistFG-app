async function guardarPresupuesto(){
  if(!currentCalc){toast('Calculá primero el presupuesto');return;}
  const entry={
    nombre:currentCalc.nombre||'Sin nombre',
    telefono:currentCalc.tel||'',
    direccion:currentCalc.dir||'',
    fecha_relevamiento:currentCalc.fecha||new Date().toISOString().split('T')[0],
    tipo_obra:currentCalc.tipo||'nueva',
    notas:currentCalc.notas||'',
    total_materiales:Math.round(currentCalc.totalMat),
    total_mano_obra:Math.round(currentCalc.totalMO),
    total_general:Math.round(currentCalc.total),
    ambientes:currentCalc.rooms.length,
    datos_json:JSON.stringify({rooms:currentCalc.rooms,matItems:currentCalc.matItems,moItems:currentCalc.moItems}),
    created_at:new Date().toISOString(),
  };

  // Guardar localmente siempre
  const local=JSON.parse(localStorage.getItem('historial')||'[]');
  const localEntry={...entry,id:'local_'+Date.now()};
  local.unshift(localEntry);
  if(local.length>100) local.pop();
  localStorage.setItem('historial',JSON.stringify(local));

  // Guardar en Supabase si está disponible
  if(sbReady){
    try {
      const r=await sbFetch('POST','/rest/v1/presupuestos',entry);
      if(r.ok){
        toast('✓ Guardado en la nube y en el celular');
        return;
      }
    } catch {}
    toast('✓ Guardado localmente (error nube)');
  } else {
    toast('✓ Guardado en el celular');
  }
}

async function cargarHistorialCloud(){
  if(!sbReady) return [];
  try {
    const r=await sbFetch('GET','/rest/v1/presupuestos?select=*&order=created_at.desc&limit=100');
    if(r.ok) return await r.json();
  } catch {}
  return [];
}

async function renderHistorial(){
  const search=(document.getElementById('hist-search')?.value||'').toLowerCase();
  const el=document.getElementById('hist-list');

  // Intentar cargar nube + local
  let cloudItems=[];
  if(sbReady) cloudItems=await cargarHistorialCloud();
  const localItems=JSON.parse(localStorage.getItem('historial')||'[]');

  // Deduplicar: preferir cloud, identificar por nombre+fecha
  const seen=new Set();
  let all=[];
  for(const it of cloudItems){
    const k=it.nombre+'|'+it.fecha_relevamiento;
    if(!seen.has(k)){seen.add(k);all.push({...it,_src:'cloud'});}
  }
  for(const it of localItems){
    const k=it.nombre+'|'+it.fecha_relevamiento;
    if(!seen.has(k)){seen.add(k);all.push({...it,_src:'local'});}
  }

  // Filtrar
  if(search) all=all.filter(it=>(it.nombre||'').toLowerCase().includes(search)||(it.direccion||'').toLowerCase().includes(search));

  document.getElementById('hist-count').textContent=`${all.length} relevamiento${all.length!==1?'s':''}`;

  if(!all.length){
    el.innerHTML=`<div class="hist-empty">
      <div class="hist-empty-icon">${search?'🔍':'📋'}</div>
      <p style="font-size:15px;font-weight:700;color:var(--text2);margin-bottom:6px">${search?'Sin resultados':'Historial vacío'}</p>
      <p style="font-size:13px;color:var(--text3)">${search?'Probá con otro nombre o dirección':'Los presupuestos guardados aparecen acá'}</p>
    </div>`;
    return;
  }

  el.innerHTML=all.map(e=>{
    const srcIcon=e._src==='cloud'?'☁️':'📱';
    const tipos={nueva:'Instalación nueva',refaccion:'Refacción',ampliacion:'Ampliación'};
    return `<div class="hist-item">
      <div class="hist-top">
        <span class="hist-nombre">${e.nombre||'Sin nombre'}</span>
        <span class="hist-total">${fmt(e.total_general||0)}</span>
      </div>
      <div class="hist-sub">${e.direccion||'—'} · ${e.fecha_relevamiento||'—'} · ${e.ambientes||0} amb.</div>
      <div class="hist-tags">
        <span class="tag tb">${tipos[e.tipo_obra]||e.tipo_obra||'—'}</span>
        <span class="tag tg">Mat. ${fmt(e.total_materiales||0)}</span>
        <span class="tag tp">MO ${fmt(e.total_mano_obra||0)}</span>
        <span style="font-size:11px;color:#aaa">${srcIcon} ${e._src==='cloud'?'Nube':'Celular'}</span>
      </div>
      ${e.notas?`<p style="font-size:12px;color:#888;margin-top:6px">📝 ${e.notas}</p>`:''}
      <div class="hist-actions">
        <button class="hbtn" onclick="verDetalle('${e.id||''}','${e._src}')"><i class="ti ti-eye"></i> Ver detalle</button>
        ${e.telefono?`<a class="hbtn" href="tel:${e.telefono}"><i class="ti ti-phone"></i> Llamar</a>`:''}
        <button class="hbtn danger" onclick="eliminarEntry('${e.id||''}','${e._src}')"><i class="ti ti-trash"></i></button>
      </div>
    </div>`;
  }).join('');
}

