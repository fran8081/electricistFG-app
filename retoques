.alcance-badge.parcial{background:rgba(250,204,21,.12);color:#facc15;border:1px solid rgba(250,204,21,.2)}

/* ── LANDING PAGE ─────────────────────────────── */
#landing{position:fixed;inset:0;z-index:500;background:#0a0a0f;overflow:hidden;display:flex;flex-direction:column;align-items:center;justify-content:center;transition:opacity .6s ease}
#landing.exit{animation:landingExit .7s cubic-bezier(.7,0,.3,1) forwards}
@keyframes landingExit{
  0%{opacity:1;transform:translateY(0)}
  30%{opacity:1}
  100%{opacity:0;transform:translateY(-60px)}
}

/* Fondo con grid eléctrico */
.grid-bg{position:absolute;inset:0;background-image:linear-gradient(rgba(124,58,237,.07) 1px,transparent 1px),linear-gradient(90deg,rgba(124,58,237,.07) 1px,transparent 1px);background-size:40px 40px;animation:gridMove 8s linear infinite}
@keyframes gridMove{to{background-position:40px 40px}}

/* Glow de fondo */
.bg-glow{position:absolute;width:500px;height:500px;border-radius:50%;background:radial-gradient(circle,rgba(124,58,237,.18) 0%,transparent 70%);top:50%;left:50%;transform:translate(-50%,-60%);animation:glowPulse 4s ease-in-out infinite}
.bg-glow2{width:300px;height:300px;background:radial-gradient(circle,rgba(250,204,21,.08) 0%,transparent 70%);top:50%;left:50%;transform:translate(-50%,10%);animation:glowPulse 4s ease-in-out infinite;animation-delay:2s}
@keyframes glowPulse{0%,100%{opacity:.6;transform:translate(-50%,-60%) scale(1)}50%{opacity:1;transform:translate(-50%,-60%) scale(1.15)}}

/* Rayos animados de fondo */
.bg-bolt{position:absolute;opacity:0;animation:bgBoltFlash 6s ease-in-out infinite}
.bg-bolt:nth-child(1){top:10%;left:15%;animation-delay:0s}
.bg-bolt:nth-child(2){top:20%;right:12%;animation-delay:2s}
.bg-bolt:nth-child(3){bottom:20%;left:10%;animation-delay:4s}
.bg-bolt:nth-child(4){bottom:15%;right:18%;animation-delay:1.5s}
@keyframes bgBoltFlash{
  0%,90%,100%{opacity:0}
  92%{opacity:.4;filter:drop-shadow(0 0 8px #facc15)}
  96%{opacity:0}
  98%{opacity:.25}
}

/* Rayo principal central */
.main-bolt-wrap{position:relative;margin-bottom:2rem;animation:boltEntrance .8s cubic-bezier(.34,1.56,.64,1) .3s both}
@keyframes boltEntrance{
  from{opacity:0;transform:scale(.3) rotate(-30deg)}
  to{opacity:1;transform:scale(1) rotate(0deg)}
}
.main-bolt-ring{position:absolute;inset:-20px;border-radius:50%;border:1.5px solid rgba(250,204,21,.3);animation:mainRing 2s ease-in-out infinite}
.main-bolt-ring2{inset:-40px;border:1px solid rgba(124,58,237,.2);animation-delay:.5s;animation-duration:2.5s}
.main-bolt-ring3{inset:-65px;border:1px solid rgba(124,58,237,.1);animation-delay:1s;animation-duration:3s}
@keyframes mainRing{
  0%,100%{transform:scale(1);opacity:.5}
  50%{transform:scale(1.08);opacity:1}
}
.main-bolt-circle{width:110px;height:110px;border-radius:28px;background:linear-gradient(135deg,#7c3aed,#5b21b6);display:flex;align-items:center;justify-content:center;box-shadow:0 0 40px rgba(124,58,237,.6),0 0 80px rgba(124,58,237,.2);animation:mainBoltGlow 2s ease-in-out infinite}
@keyframes mainBoltGlow{
  0%,100%{box-shadow:0 0 40px rgba(124,58,237,.6),0 0 80px rgba(124,58,237,.2)}
  50%{box-shadow:0 0 60px rgba(124,58,237,.9),0 0 120px rgba(124,58,237,.4),0 0 160px rgba(250,204,21,.1)}
}
.main-bolt-svg{animation:mainBoltFlash 2s ease-in-out infinite}
@keyframes mainBoltFlash{
  0%,70%,100%{filter:brightness(1) drop-shadow(0 0 6px rgba(250,204,21,.5))}
  75%{filter:brightness(2.5) drop-shadow(0 0 16px #facc15)}
  80%{filter:brightness(1)}
  85%{filter:brightness(2) drop-shadow(0 0 10px #facc15)}
}

/* Partículas eléctricas flotantes */
.particle{position:absolute;border-radius:50%;pointer-events:none;animation:particleFloat linear infinite}
@keyframes particleFloat{
  0%{transform:translateY(0) translateX(0);opacity:0}
  10%{opacity:1}
  90%{opacity:.5}
  100%{transform:translateY(-120px) translateX(var(--dx));opacity:0}
}

/* Texto landing */
.land-eyebrow{font-size:11px;font-weight:700;letter-spacing:.15em;text-transform:uppercase;color:#a78bfa;margin-bottom:.75rem;opacity:0;animation:fadeUp .5s ease .9s forwards}
.land-title{font-size:clamp(28px,8vw,42px);font-weight:800;text-align:center;color:#fff;line-height:1.15;margin-bottom:.75rem;opacity:0;animation:fadeUp .5s ease 1.1s forwards}
.land-title span{color:#facc15;position:relative;display:inline-block}
.land-title span::after{content:'';position:absolute;bottom:-3px;left:0;width:100%;height:2px;background:linear-gradient(90deg,#facc15,transparent);animation:underlineGrow 1s ease 1.8s both}
@keyframes underlineGrow{from{width:0}to{width:100%}}
.land-sub{font-size:14px;color:#888;text-align:center;margin-bottom:2.5rem;opacity:0;animation:fadeUp .5s ease 1.3s forwards;line-height:1.6;max-width:300px}

/* Features */
.land-features{display:flex;gap:1.5rem;margin-bottom:2.5rem;opacity:0;animation:fadeUp .5s ease 1.5s forwards}
.land-feat{display:flex;flex-direction:column;align-items:center;gap:5px}
.land-feat-icon{width:36px;height:36px;border-radius:10px;background:rgba(124,58,237,.15);border:1px solid rgba(124,58,237,.3);display:flex;align-items:center;justify-content:center;font-size:16px}
.land-feat-txt{font-size:10px;color:#666;text-align:center;line-height:1.3}

/* CTA button */
.land-cta{opacity:0;animation:fadeUp .5s ease 1.7s forwards;position:relative}
.land-cta-btn{padding:16px 40px;background:linear-gradient(135deg,#7c3aed,#5b21b6);color:#fff;border:none;border-radius:50px;font-size:16px;font-weight:700;cursor:pointer;font-family:inherit;position:relative;overflow:hidden;box-shadow:0 8px 30px rgba(124,58,237,.5);transition:transform .2s,box-shadow .2s;display:flex;align-items:center;gap:10px;white-space:nowrap}
.land-cta-btn:hover{transform:translateY(-2px);box-shadow:0 12px 40px rgba(124,58,237,.7)}
.land-cta-btn:active{transform:scale(.97)}
.land-cta-btn::before{content:'';position:absolute;inset:0;background:linear-gradient(135deg,rgba(255,255,255,.15),transparent);border-radius:inherit}
.cta-bolt{animation:ctaBoltSpin 2s ease-in-out infinite}
@keyframes ctaBoltSpin{
  0%,100%{filter:brightness(1) drop-shadow(0 0 3px #facc15)}
  50%{filter:brightness(2) drop-shadow(0 0 8px #facc15)}
}

/* RAYO DE TRANSICIÓN */
#bolt-transition{position:fixed;inset:0;z-index:600;pointer-events:none;display:none}
#bolt-transition.active{display:block}
.bt-bolt{position:absolute;left:50%;top:0;transform:translateX(-50%);width:60px;height:100vh;display:flex;justify-content:center;overflow:visible}
.bt-flash{position:absolute;inset:0;background:radial-gradient(ellipse at center,rgba(250,204,21,.6) 0%,transparent 70%);opacity:0;animation:btFlash .5s ease forwards}
@keyframes btFlash{0%{opacity:0}20%{opacity:1}100%{opacity:0}}
.bt-bolt-svg{animation:btBoltDraw .4s ease forwards;stroke-dasharray:400;stroke-dashoffset:400}
@keyframes btBoltDraw{to{stroke-dashoffset:0}}
.bt-shatter{position:absolute;inset:0;overflow:hidden}
.bt-shard{position:absolute;background:#0a0a0f;animation:btShard .5s ease forwards}
@keyframes btShard{
  0%{transform:translateY(0) scaleX(1);opacity:1}
  100%{transform:translateY(var(--dy)) scaleX(.8);opacity:0}
}

/* ── ANIMACIONES ────────────────────────────────── */

/* Splash screen */
.splash{position:fixed;inset:0;background:var(--bg);display:flex;flex-direction:column;align-items:center;justify-content:center;z-index:999;transition:opacity .5s ease, transform .5s ease}
