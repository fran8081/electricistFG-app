/* Entrada de steps */
.step.active{animation:stepIn .3s ease}
@keyframes stepIn{
  from{opacity:0;transform:translateX(16px)}
  to{opacity:1;transform:translateX(0)}
}

/* Contador animado */
.count-anim{transition:all .4s ease}

/* Resultado aparece */
.pbox{animation:none}
.pbox.show{animation:presupIn .5s cubic-bezier(.34,1.2,.64,1)}
@keyframes presupIn{
  from{opacity:0;transform:translateY(20px) scale(.96)}
