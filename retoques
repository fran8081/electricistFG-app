.spark{position:absolute;width:3px;height:3px;border-radius:50%;background:#a78bfa;pointer-events:none;animation:sparkFly 1.5s ease forwards}
@keyframes sparkFly{
  0%{opacity:1;transform:translate(0,0) scale(1)}
  100%{opacity:0;transform:translate(var(--dx),var(--dy)) scale(0)}
}

