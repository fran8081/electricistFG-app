@keyframes boltPop{
  0%{transform:scale(0) rotate(-20deg);opacity:0}
  60%{transform:scale(1.2) rotate(5deg);opacity:1}
  100%{transform:scale(1) rotate(0deg);opacity:1}
}
.splash-ring{position:absolute;width:120px;height:120px;border-radius:50%;border:2px solid var(--purple);opacity:0;animation:ringOut 1s ease .3s forwards}
.splash-ring2{animation-delay:.5s;width:160px;height:160px}
@keyframes ringOut{
  0%{transform:scale(.5);opacity:.8}
  100%{transform:scale(1.4);opacity:0}
}
.splash-title{font-size:20px;font-weight:700;color:var(--text);margin-top:1.5rem;opacity:0;animation:fadeUp .4s ease .7s forwards}
